{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles for RBAC.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "Case": {
      "title": "Case",
      "description": "Information regarding uploaded cases/judgments.",
      "type": "object",
      "properties": {
        "case_number": { "type": "string" },
        "file_url": { "type": "string" },
        "file_name": { "type": "string" },
        "status": { "type": "string", "enum": ["uploaded", "processing", "pending_review", "approved", "rejected"] },
        "upload_date": { "type": "string" },
        "uploaded_by": { "type": "string" }
      },
      "required": ["file_name", "status", "upload_date", "uploaded_by"]
    },
    "ExtractedData": {
      "title": "Extracted Data",
      "description": "AI extracted metadata for a case.",
      "type": "object",
      "properties": {
        "case_id": { "type": "string" },
        "actions": { "type": "string" },
        "appeal_deadline": { "type": "string" },
        "urgency": { "type": "string" },
        "departments": { "type": "string" },
        "raw_json": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_review", "approved", "rejected"] },
        "reviewer_notes": { "type": "string" },
        "reviewed_at": { "type": "string" },
        "reviewed_by": { "type": "string" }
      },
      "required": ["case_id", "status"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Immutable log for actions.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "action": { "type": "string" },
        "entity_type": { "type": "string" },
        "entity_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["user_id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles defining their access roles."
    },
    "/cases/{caseId}": {
      "schema": { "$ref": "#/entities/Case" },
      "description": "Cases or Judgments uploaded to the system."
    },
    "/extractedData/{extractionId}": {
      "schema": { "$ref": "#/entities/ExtractedData" },
      "description": "Metadata generated by AI and verified by Human."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Log of actions performed."
    }
  }
}
